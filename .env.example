# ============================================================
# Advanced Medical Inventory & Pharmacy ERP/POS System
# Environment Configuration
# ============================================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medical_inventory?schema=public"

# Node Environment
NODE_ENV="development"
PORT=4000
API_URL="http://localhost:4000"

# Web Client Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="MedCare Pharmacy ERP"

# JWT Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-change-in-production-min-32-chars-long"
REFRESH_TOKEN_EXPIRATION="7d"

# Password Security
PASSWORD_SALT_ROUNDS=12

# File Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Optional Redis Cache / Queue
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# SMTP / Email Notification (Optional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@medcarepharmacy.com"
SMTP_FROM_NAME="MedCare Pharmacy System"

# SMS / WhatsApp API (Optional)
SMS_API_KEY=""
SMS_SENDER_ID=""
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
