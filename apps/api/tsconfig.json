{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@medical-inventory/shared-types": ["../../packages/shared-types/src"],
      "@medical-inventory/shared-types/*": ["../../packages/shared-types/src/*"],
      "@medical-inventory/constants": ["../../packages/constants/src"],
      "@medical-inventory/constants/*": ["../../packages/constants/src/*"],
      "@medical-inventory/shared-utils": ["../../packages/shared-utils/src"],
      "@medical-inventory/shared-utils/*": ["../../packages/shared-utils/src/*"],
      "@medical-inventory/validation": ["../../packages/validation/src"],
      "@medical-inventory/validation/*": ["../../packages/validation/src/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src/**/*", "../../packages/*/src/**/*"]
}
