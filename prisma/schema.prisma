  retentionDays  Int       @default(7) @map("retention_days")
  autoSyncDaily  Boolean   @default(false) @map("auto_sync_daily")
  folderId       String?   @map("folder_id")
  folderName     String?   @default("MedCare_Pharmacy_Backups") @map("folder_name")
  serviceAccount String?   @map("service_account")
  connected      Boolean   @default(false)
