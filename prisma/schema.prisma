  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([customerId, branchId])
  @@index([customerId])
  @@index([branchId])
  @@map("customer_branch_relations")
}

// §29 Background Job System
model BackgroundJob {
  id          String    @id @default(uuid())
  jobType     String    @map("job_type") // REPORT_EXPORT | PDF_GENERATE | BULK_IMPORT | NOTIFICATION | ANALYTICS
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  requestedBy String    @map("requested_by")
  branchId    String?   @map("branch_id")
  payload     String?   // JSON params
  resultUrl   String?   @map("result_url")
  errorMessage String?  @map("error_message")
  progress    Int       @default(0) // 0-100
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  requester User @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([requestedBy, status])
  @@index([createdAt])
  @@map("background_jobs")
}

// §41 Error Log / Error Monitoring
model ErrorLog {
  id             String   @id @default(uuid())
  requestId      String?  @map("request_id")
  endpoint       String?
  userId         String?  @map("user_id")
  organizationId String?  @map("organization_id")
  branchId       String?  @map("branch_id")
  errorCategory  String?  @map("error_category")
  safeMessage    String   @map("safe_message")
  stackTrace     String?  @map("stack_trace") // server-only, never sent to client
  statusCode     Int?     @map("status_code")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("error_logs")
}

// §3 Central Purchase Allocation (for Super Admin central purchase)
model CentralPurchaseAllocation {
  id              String   @id @default(uuid())
  purchaseId      String   @map("purchase_id")
  branchId        String   @map("branch_id")
  medicineId      String   @map("medicine_id")
  allocatedQty    Int      @map("allocated_qty")
  receivedQty     Int      @default(0) @map("received_qty")
  createdAt       DateTime @default(now()) @map("created_at")

  purchase  PurchaseInvoice @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  medicine  Medicine        @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([branchId])
  @@map("central_purchase_allocations")
}

// §37 Branch Access Switching Log (extends audit trail for Super Admin switches)
model BranchSwitchLog {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  fromBranchId    String?  @map("from_branch_id")
  toBranchId      String   @map("to_branch_id")
  reason          String?
  ipAddress       String?  @map("ip_address")
  switchedAt      DateTime @default(now()) @map("switched_at")

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromBranch Branch? @relation("SwitchFrom", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch   Branch  @relation("SwitchTo", fields: [toBranchId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([switchedAt])
  @@map("branch_switch_logs")
}


// ============================================================
// WHATSAPP INTEGRATION & CUSTOMER MESSAGING
// ============================================================

model WhatsAppSession {
  id           String    @id @default(uuid())
  branchId     String    @unique @map("branch_id")
  status       String    @default("DISCONNECTED") // DISCONNECTED, CONNECTING, QR_READY, CONNECTED
  phoneNumber  String?   @map("phone_number")
  pushName     String?   @map("push_name")
  profilePic   String?   @map("profile_pic")
  qrCode       String?   @map("qr_code")
  authData     String?   @map("auth_data")
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  messages     WhatsAppMessageLog[]

  @@map("whatsapp_sessions")
}

model WhatsAppMessageLog {
  id             String    @id @default(uuid())
  sessionId      String?   @map("session_id")
  branchId       String    @map("branch_id")
  customerId     String?   @map("customer_id")
  invoiceId      String?   @map("invoice_id")
  paymentId      String?   @map("payment_id")
  messageType    String    @default("TEXT") // TEXT, BILL_INVOICE, PAYMENT_RECEIPT, DUE_REMINDER, PAYMENT_CONFIRMATION, DIRECT_CHAT
  recipientPhone String    @map("recipient_phone")
  recipientName  String?   @map("recipient_name")
  content        String
  mediaUrl       String?   @map("media_url")
  status         String    @default("QUEUED") // QUEUED, SENDING, SENT, FAILED
  error          String?
  sentByUserId   String?   @map("sent_by_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  sentAt         DateTime? @map("sent_at")

  session        WhatsAppSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice        SalesInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([recipientPhone])
  @@index([status])
  @@map("whatsapp_message_logs")
}
