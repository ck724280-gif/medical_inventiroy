  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("backup_configs")
}

// ============================================================
// P6 NEW MODELS — Enterprise ERP Upgrade
// ============================================================

// §12 Approval Workflow
model ApprovalRequest {
  id              String    @id @default(uuid())
  organizationId  String?   @map("organization_id")
  branchId        String    @map("branch_id")
  requestedBy     String    @map("requested_by")
  approvedBy      String?   @map("approved_by")
  action          String    // PURCHASE_APPROVAL | STOCK_ADJUST | INVOICE_CANCEL | HIGH_DISCOUNT | EXPENSE | SUPPLIER_PAYMENT | LARGE_REFUND | MANUAL_STOCK_IN | MANUAL_STOCK_OUT
  entityType      String    @map("entity_type")
  entityId        String?   @map("entity_id")
  requestedValue  String?   @map("requested_value")
  approvedValue   String?   @map("approved_value")
  reason          String?
  notes           String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requestedAt     DateTime  @default(now()) @map("requested_at")
  resolvedAt      DateTime? @map("resolved_at")

  branch      Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requester   User   @relation("ApprovalRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver    User?  @relation("ApprovalApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([requestedBy])
  @@index([requestedAt])
  @@map("approval_requests")
}

// §13 Discount Policy per Role
model DiscountPolicy {
  id                     String   @id @default(uuid())
  branchId               String?  @map("branch_id") // null = org-wide default
  roleName               String   @map("role_name") // CASHIER | MANAGER | PHARMACIST | SUPER_ADMIN
  maxDiscountPercent     Float    @default(5) @map("max_discount_percent")
  requiresApprovalAbove  Float?   @map("requires_approval_above") // If discount > this, needs approval
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([branchId, roleName])
  @@map("discount_policies")
}

// §20 Feature Flags per Branch
model BranchFeatureFlag {
  id         String   @id @default(uuid())
  branchId   String   @map("branch_id")
  featureKey String   @map("feature_key") // POS | CREDIT_SALE | WHOLESALE | STOCK_TRANSFER | EXPENSE | CENTRAL_PURCHASE | REPORTS | IMPORT_EXPORT
  isEnabled  Boolean  @default(true) @map("is_enabled")
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, featureKey])
  @@index([branchId])
  @@map("branch_feature_flags")
}

// §49 Customer Credit / Receivable Management
model CustomerCredit {
  id              String    @id @default(uuid())
  customerId      String    @map("customer_id")
  branchId        String    @map("branch_id")
  invoiceId       String?   @map("invoice_id")
  creditAmount    Float     @default(0) @map("credit_amount")
  paidAmount      Float     @default(0) @map("paid_amount")
  outstandingAmount Float   @default(0) @map("outstanding_amount")
  paymentDate     DateTime? @map("payment_date")
  paymentMethod   String?   @map("payment_method") // CASH | UPI | CARD | BANK
  collectedBy     String?   @map("collected_by")
  reference       String?
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customer  Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invoice   SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([customerId, branchId])
  @@index([branchId, outstandingAmount])
  @@map("customer_credits")
}

// §4 Supplier Branch Relation (org-level supplier master)
model SupplierBranchRelation {
  id              String   @id @default(uuid())
  supplierId      String   @map("supplier_id")
  branchId        String   @map("branch_id")
  branchLedgerBalance Float @default(0) @map("branch_ledger_balance")
